# Copie ce fichier en .env pour le développement local. En production (Railway),
# ces valeurs sont définies comme variables d'environnement du service, jamais commitées.

# Base de données (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Serveur
PORT=4000
NODE_ENV="development"
URL_PUBLIQUE="http://localhost:4000"
URL_FRONTEND="http://localhost:3000"

# Sécurité inter-services (BFF Vercel -> API Railway)
JETON_SERVICE="change-moi"
SECRET_SESSION="change-moi"
SEL_IP="change-moi"

# Cloudinary
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# MonCash (Digicel)
MONCASH_CLIENT_ID=""
MONCASH_CLIENT_SECRET=""
MONCASH_MODE="sandbox"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_DEVISE_PRESENTATION="HTG"

# NatCash (réservé — flux assisté au lancement, pas d'intégration API)
NATCASH_MARCHAND_ID=""
NATCASH_CLE_API=""
NATCASH_MODE="sandbox"

# E-mail
RESEND_API_KEY=""
EMAIL_EXPEDITEUR="Kingo's <commandes@kingos.ht>"
EMAIL_ADMIN="contact@kingos.ht"

# Observabilité
SENTRY_DSN=""
NIVEAU_LOG="info"
